 const $=id=>document.getElementById(id), modes={easy:{label:'Facile',seconds:240},normal:{label:'Normal',seconds:120},hard:{label:'Difficile',seconds:60}};let cells=[],butterflies=0,gold=Number(localStorage.getItem('gardenGold')||0),loopCount=0,loopGoal=2,bestButterflies=Number(localStorage.getItem('gardenButterflyRecord')||0),seed=1,unlocked=[],mode='normal',timeLeft=modes.normal.seconds,playing=false,shopWasPlaying=false,timerInterval=null,adInterval=null,timer;
